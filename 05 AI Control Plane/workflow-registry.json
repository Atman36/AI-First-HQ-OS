      "acceptance_evidence": [
        "weekly metrics are generated from telemetry rather than chat reconstruction",
        "every breached threshold has a named owner or an explicit decision to defer",
        "carry-forward items are reflected in the control plane or weekly plan"
      ],
      "transition_owners": {
        "collect->analyze": "task_manager",
        "analyze->decide": "governor",
