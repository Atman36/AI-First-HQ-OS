{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "roles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "role_type",
          "default_autonomy_tier",
          "mission"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role_type": {
            "type": "string",
            "enum": [
              "human",
              "ai"
            ]
          },
          "default_autonomy_tier": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "owns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "legacy_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "escalates_to": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
