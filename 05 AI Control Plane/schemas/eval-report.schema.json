{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "run_id",
    "status",
    "dataset_version",
    "dataset_name",
    "dataset_path",
    "generated_at",
    "task_id",
    "trace",
    "summary",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "dataset_path": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "trace": {
      "type": "object",
      "required": [
        "trace_contract_version",
        "trace_entity",
        "trace_id",
        "task_id"
      ],
      "properties": {
        "trace_contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "trace_entity": {
          "type": "string",
          "enum": [
            "run"
          ]
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_id": {
          "type": "string"
        },
        "subject_run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "duration_seconds"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "duration_seconds",
          "exit_code",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "exit_code": {
            "type": "integer"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "passed"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "details": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
