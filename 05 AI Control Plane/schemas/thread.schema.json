{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_type",
    "id",
    "title",
    "owner",
    "status",
    "mission_ids",
    "active_mission_id",
    "active_run_id",
    "latest_spec_path",
    "latest_handoff_path",
    "resume_packet_path",
    "created_at",
    "updated_at",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entity_type": {
      "type": "string",
      "const": "thread"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "paused",
        "archived"
      ]
    },
    "mission_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_mission_id": {
      "type": "string"
    },
    "active_run_id": {
      "type": "string"
    },
    "latest_spec_path": {
      "type": "string"
    },
    "latest_handoff_path": {
      "type": "string"
    },
    "resume_packet_path": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
