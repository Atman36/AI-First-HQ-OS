{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "approval_class": {
      "type": "string",
      "enum": [
        "auto_low_risk",
        "human_before_external",
        "required_review",
        "founder_only",
        "forbidden_without_explicit_approval"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role_id",
        "resource_scope",
        "action",
        "approval_class"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_scope": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "approval_class": {
          "$ref": "#/$defs/approval_class"
        }
      }
    },
    "deny": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role_id",
        "resource_scope",
        "action",
        "reason"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_scope": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "version",
    "updated_at",
    "grants",
    "denies"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "denies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deny"
      }
    }
  }
}
