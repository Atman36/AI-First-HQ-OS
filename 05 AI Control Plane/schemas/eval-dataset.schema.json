{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "name",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "command",
          "expectations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "command"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expectations": {
            "type": "object",
            "required": [
              "exit_code"
            ],
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "stdout_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stderr_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stdout_not_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stderr_not_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
