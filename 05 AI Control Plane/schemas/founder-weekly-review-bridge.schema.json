{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "contract_policy",
    "source_files",
    "active_tasks",
    "workflow_requirements",
    "breached_metrics",
    "metadata"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "contract_name",
        "schema_path",
        "schema_version",
        "versioning"
      ],
      "properties": {
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_name": {
          "type": "string",
          "const": "founder_weekly_review_snapshot"
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "versioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_version",
            "minimum_consumer_version",
            "maximum_consumer_version",
            "additive_change_rule",
            "breaking_change_rule"
          ],
          "properties": {
            "current_version": {
              "type": "integer",
              "minimum": 1
            },
            "minimum_consumer_version": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_consumer_version": {
              "type": "integer",
              "minimum": 1
            },
            "additive_change_rule": {
              "type": "string",
              "minLength": 1
            },
            "breaking_change_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_work",
        "workflow_registry",
        "operating_policies",
        "telemetry_review"
      ],
      "properties": {
        "active_work": {
          "type": "string",
          "minLength": 1
        },
        "workflow_registry": {
          "type": "string",
          "minLength": 1
        },
        "operating_policies": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_review": {
          "type": "string"
        }
      }
    },
    "active_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "column"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "string",
            "minLength": 1
          },
          "manager": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "next_step": {
            "type": "string"
          },
          "done_when": {
            "type": "string"
          },
          "primary_update_file": {
            "type": "string"
          },
          "accepts_result": {
            "type": "string"
          },
          "risk_tier": {
            "type": "string"
          },
          "autonomy_tier": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "workflow_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "breached_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_tasks",
        "active_tasks",
        "actionable_tasks",
        "founder_review_tasks"
      ],
      "properties": {
        "total_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "active_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "actionable_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "founder_review_tasks": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
