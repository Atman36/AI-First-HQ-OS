{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "hooks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "enum": [
              "session_start",
              "pre_action",
              "post_action",
              "approval_requested",
              "run_finished"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action_prefixes": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "allow",
                "allow_with_review",
                "pause_for_founder_approval",
                "block"
              ]
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stop_on_error": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
