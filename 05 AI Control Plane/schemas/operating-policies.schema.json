{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id_and_description": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "threshold": {
      "type": "object",
      "required": [
        "metric_id",
        "comparison",
        "target",
        "owner"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            "=",
            ">=",
            ">"
          ]
        },
        "target": {
          "type": "number"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "escalate_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "stage",
    "autonomy_tiers",
    "risk_tiers",
    "approvals",
    "weekly_metric_review",
    "eval_policy",
    "metric_thresholds"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "autonomy_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id_and_description"
      }
    },
    "risk_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/id_and_description"
          },
          {
            "type": "object",
            "required": [
              "default_approval"
            ],
            "properties": {
              "default_approval": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "approvals": {
      "type": "object",
      "required": [
        "human_only_actions",
        "governor_review_required_for",
        "default_spend_without_budget_eur",
        "max_external_send_without_review"
      ]
    },
    "weekly_metric_review": {
      "type": "object",
      "required": [
        "cadence",
        "owner",
        "support",
        "approver",
        "required_metrics"
      ]
    },
    "eval_policy": {
      "type": "object",
      "required": [
        "minimum_checks_for_repeated_work",
        "control_plane_change_requires"
      ]
    },
    "metric_thresholds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threshold"
      }
    }
  }
}
