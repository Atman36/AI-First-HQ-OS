{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "default_decision",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "default_decision": {
      "type": "string",
      "enum": [
        "allow",
        "allow_with_review",
        "pause_for_founder_approval",
        "block"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action_prefix",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action_prefix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "allow_with_review",
              "pause_for_founder_approval",
              "block"
            ]
          },
          "justification": {
            "type": "string"
          },
          "path_prefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tool_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "call_id_prefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk_tiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "autonomy_tiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "match": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          },
          "not_match": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
